  strings:
  - key: new_game
    entries:
    - languageCode: ru
      text: "\u041D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430"
    - languageCode: en
      text: New Game
    - languageCode: fr
      text: Nouvelle partie
  - key: load_game
    entries:
