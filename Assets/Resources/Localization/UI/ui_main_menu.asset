  - key: version
    entries:
    - languageCode: ru
      text: "\u0412\u0435\u0440\u0441\u0438\u044F \u0438\u0433\u0440\u044B 0.0.355"
    - languageCode: en
      text: Game version 0.0.355
    - languageCode: fr
      text: Version du jeu 0.0.355
  - key: settings
    entries:
    - languageCode: ru
      text: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    - languageCode: en
      text: Settings
    - languageCode: fr
      text: "Param\xE8tres"
  - key: resume
