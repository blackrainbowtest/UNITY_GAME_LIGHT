      text: "\u041E\u0442\u043C\u0435\u043D\u0430"
    - languageCode: en
      text: Cancel
    - languageCode: fr
      text: Annuler
  - key: reset
    entries:
    - languageCode: ru
      text: "\u0421\u0431\u0440\u043E\u0441"
    - languageCode: en
      text: Reset
    - languageCode: fr
      text: "R\xE9initialiser"
  - key: back
    entries:
    - languageCode: ru
      text: "\u041D\u0430\u0437\u0430\u0434"
    - languageCode: en
      text: Back
    - languageCode: fr
      text: Retour
  - key: skip
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    - languageCode: en
      text: Skip
    - languageCode: fr
      text: Passer
  - key: confirm_overwrite_save
    entries:
    - languageCode: ru
      text: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
        \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C
        \u044D\u0442\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435?"
    - languageCode: en
      text: Are you sure you want to overwrite this save?
    - languageCode: fr
      text: Are you sure you want to overwrite this save?
  - key: confirm_delete_save
    entries:
    - languageCode: ru
      text: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
        \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C
        \u044D\u0442\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435?"
    - languageCode: en
      text: Are you sure you want to delete this save?
    - languageCode: fr
      text: Are you sure you want to delete this save?
  - key: day
    entries:
    - languageCode: ru
      text: "\u0414\u0435\u043D\u044C"
    - languageCode: en
      text: Day
    - languageCode: fr
      text: Jour
  - key: time
    entries:
    - languageCode: ru
      text: "\u0412\u0440\u0435\u043C\u044F"
    - languageCode: en
      text: Time
    - languageCode: fr
      text: Temps
  - key: confirm
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C"
    - languageCode: en
      text: Confirm
    - languageCode: fr
      text: Confirm
  - key: used
    entries:
    - languageCode: ru
      text: "\u0423\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043E
        \u0441\u0435\u0433\u043E\u0434\u043D\u044F -50%"
    - languageCode: en
      text: Already used today -50%
    - languageCode: fr
      text: "D\xE9j\xE0 utilis\xE9 aujourd'hui -50%"
  - key: currentStructureLevelKey
    entries:
    - languageCode: ru
      text: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C: {0}"
    - languageCode: en
      text: 'Level: {0}'
    - languageCode: fr
      text: 'Niveau: {0}'
  - key: loading
    entries:
    - languageCode: ru
      text: "\u0417\u0410\u0413\u0420\u0423\u0417\u041A\u0410"
    - languageCode: en
      text: LOADING
    - languageCode: fr
      text: CHARGEMENT
  - key: loading...
    entries:
    - languageCode: ru
      text: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430..."
    - languageCode: en
      text: Loading...
    - languageCode: fr
      text: Chargement...
  - key: pls_wait
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435..."
    - languageCode: en
      text: Please wait...
    - languageCode: fr
      text: Veuillez patienter...
  - key: hitin
    entries:
    - languageCode: ru
      text: "\u041F\u041E\u0414\u0421\u041A\u0410\u0417\u041A\u0410"
    - languageCode: en
      text: HINT
    - languageCode: fr
      text: ASTUCE
  - key: off_hitins
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u043C\u043E\u0436\u043D\u043E
        \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445
        \u0438\u0433\u0440\u044B."
    - languageCode: en
      text: Hints can be turned off in the game settings.
    - languageCode: fr
      text: "Les astuces peuvent \xEAtre d\xE9sactiv\xE9es dans les param\xE8tres
        du jeu."
  sourceCsvName: ui_system
