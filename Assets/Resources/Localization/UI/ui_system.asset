    - languageCode: ru
      text: "\u041D\u0435\u0442"
    - languageCode: en
      text: No
    - languageCode: fr
      text: No
  - key: apply
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C"
    - languageCode: en
      text: Apply
    - languageCode: fr
      text: Appliquer
  - key: cancel
    entries:
