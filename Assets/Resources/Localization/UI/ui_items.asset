%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 72b5dfd223e65a04db6c6ba1b78d3607, type: 3}
  m_Name: ui_items
  m_EditorClassIdentifier: UDA2.Localization::UIStringsData
  strings:
  - key: item.exp.name
    entries:
    - languageCode: ru
      text: "\u041E\u043F\u044B\u0442"
    - languageCode: en
      text: Experience
    - languageCode: fr
      text: "Exp\xE9rience"
  - key: item.exp.desc
    entries:
    - languageCode: ru
      text: "\u041E\u043F\u044B\u0442 \u044D\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0435
        \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E \u0432\u043E
        \u0432\u0440\u0435\u043C\u044F \u0431\u043E\u044F. \u041E\u043D\u0430 \u043D\u0443\u0436\u043D\u0430
        \u0434\u043B\u044F \u043F\u043E\u0434\u043D\u044F\u0442\u0438\u044F \u0443\u0440\u043E\u0432\u043D\u044F."
    - languageCode: en
      text: Experience is the skill gained during combat. It's needed to level up.
    - languageCode: fr
      text: "L'exp\xE9rience est la comp\xE9tence acquise au combat. Elle est n\xE9cessaire
        pour monter de niveau."
  - key: item.gold.name
    entries:
    - languageCode: ru
      text: "\u0417\u043E\u043B\u043E\u0442\u043E"
    - languageCode: en
      text: Gold
    - languageCode: fr
      text: Or
  - key: item.gold.desc
    entries:
    - languageCode: ru
      text: "\u0417\u043E\u043B\u043E\u0442\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
        \u0432\u0430\u043B\u044E\u0442\u0430 \u044D\u0442\u043E\u0433\u043E \u043C\u0438\u0440\u0430.
        \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u043F\u043E\u043A\u0443\u043F\u043E\u043A
        \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u044E\u0442\u0441\u044F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
        \u0435\u043C\u0443."
    - languageCode: en
      text: Gold is the primary currency of this world. Most purchases are made with
        it.
    - languageCode: fr
      text: L'or est la principale monnaie mondiale. La plupart des achats se font
        avec.
  - key: item.branch.name
    entries:
    - languageCode: ru
      text: "\u0412\u0435\u0442\u043A\u0430"
    - languageCode: en
      text: Stick
    - languageCode: fr
      text: Branche
  - key: item.branch.desc
    entries:
    - languageCode: ru
      text: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u0432\u0435\u0442\u043A\u0430,
        \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u0430\u044F \u043D\u0430 \u0437\u0435\u043C\u043B\u0435.\n\u041D\u0435
        \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043E\u043F\u0430\u0441\u043D\u043E\u0439,
        \u043D\u043E \u043C\u043D\u043E\u0433\u0438\u0435 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u0435
        \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u043B\u0438\u0441\u044C
        \u0438\u043C\u0435\u043D\u043D\u043E \u0441 \u043D\u0435\u0451."
    - languageCode: en
      text: "A simple stick picked up from the ground.\nIt doesn\u2019t look dangerous,
        but many legendary adventures started with something just like this."
    - languageCode: fr
      text: "Une simple branche ramass\xE9e par terre.\nElle n\u2019a pas l\u2019air
        dangereuse, mais bien des aventures l\xE9gendaires ont commenc\xE9 avec quelque
        chose comme \xE7a."
  - key: item.stick.name
    entries:
    - languageCode: ru
      text: "\u041F\u0430\u043B\u043A\u0430"
    - languageCode: en
      text: Stick
    - languageCode: fr
      text: "B\xE2ton"
  - key: item.stick.desc
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0430\u043B\u043A\u0430.\n\u041D\u0435
        \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F, \u043D\u0435
        \u0440\u0435\u0434\u043A\u0430\u044F \u0438 \u043D\u0435 \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u0430\u044F.\n\u0417\u0430\u0442\u043E
        \u0435\u0451 \u043C\u043E\u0436\u043D\u043E \u0434\u0435\u0440\u0436\u0430\u0442\u044C
        \u0432 \u0440\u0443\u043A\u0435 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
        \u0441\u0435\u0431\u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u0435\u0435,
        \u0447\u0435\u043C \u0431\u0435\u0437 \u043D\u0435\u0451."
    - languageCode: en
      text: 'Just a stick.

        Not magical, not rare, and definitely not legendary.

        Still,
        holding it makes you feel slightly safer than having nothing at all.'
    - languageCode: fr
      text: "Juste un b\xE2ton.\nNi magique, ni rare, ni l\xE9gendaire.\nMais l\u2019avoir
        en main donne un peu plus de courage que de n\u2019avoir rien du tout."
  - key: item.log.name
    entries:
    - languageCode: ru
      text: "\u0411\u0440\u0435\u0432\u043D\u043E"
    - languageCode: en
      text: Log
    - languageCode: fr
      text: Tronc
  - key: item.log.desc
    entries:
    - languageCode: ru
      text: "\u0422\u044F\u0436\u0451\u043B\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0435
        \u0431\u0440\u0435\u0432\u043D\u043E.\n\u041D\u0435\u0443\u0434\u043E\u0431\u043D\u043E
        \u043D\u043E\u0441\u0438\u0442\u044C, \u0441\u043B\u043E\u0436\u043D\u043E
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C.\n\u0417\u0430\u0442\u043E
        \u043E\u0442\u043B\u0438\u0447\u043D\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
        \u0434\u043B\u044F \u043A\u043E\u0441\u0442\u0440\u0430, \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u044B
        \u0438\u043B\u0438 \u043E\u0447\u0435\u043D\u044C \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u0430."
    - languageCode: en
      text: 'A heavy wooden log.

        Hard to carry and awkward to use.

        Perfect
        for a campfire, a barricade, or a very convincing argument.'
    - languageCode: fr
      text: "Un lourd tronc en bois.\nDifficile \xE0 transporter et peu pratique.\nId\xE9al
        pour un feu de camp, une barricade ou un argument tr\xE8s convaincant."
  - key: item.plank.name
    entries:
    - languageCode: ru
      text: "\u0414\u043E\u0441\u043A\u0430"
    - languageCode: en
      text: Plank
    - languageCode: fr
      text: Planche
  - key: item.plank.desc
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u044F\u043C\u0430\u044F \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F
        \u0434\u043E\u0441\u043A\u0430.\n\u0423\u0436\u0435 \u043D\u0435 \u0434\u0435\u0440\u0435\u0432\u043E,
        \u043D\u043E \u0435\u0449\u0451 \u043D\u0435 \u0448\u0435\u0434\u0435\u0432\u0440.\n\u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
        \u0434\u043B\u044F \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
        \u0440\u0435\u043C\u043E\u043D\u0442\u0430 \u0438 \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
        \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u044B\u0445 \u0440\u0435\u0448\u0435\u043D\u0438\u0439."
    - languageCode: en
      text: 'A straight wooden plank.

        No longer a tree, but not a masterpiece
        yet.

        Useful for building, repairs, and questionable engineering
        decisions.'
    - languageCode: fr
      text: "Une planche en bois bien droite.\nPlus vraiment un arbre, mais pas encore
        un chef-d'\u0153uvre.\nUtile pour la construction, les r\xE9parations et
        des d\xE9cisions d\u2019ing\xE9nierie douteuses."
  - key: item.nail.name
    entries:
    - languageCode: ru
      text: "\u0413\u0432\u043E\u0437\u0434\u044C"
    - languageCode: en
      text: Nail
    - languageCode: fr
      text: Clou
  - key: item.nail.desc
    entries:
    - languageCode: ru
      text: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0433\u0432\u043E\u0437\u0434\u044C.\n\u0421\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435
        \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u0435\u043D, \u043D\u043E
        \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0445 \u0440\u0443\u043A\u0430\u0445
        \u0434\u0435\u0440\u0436\u0438\u0442 \u043C\u0438\u0440 \u0432\u043C\u0435\u0441\u0442\u0435.\n\u0427\u0430\u0441\u0442\u043E
        \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0435\u0442 \u0438\u043C\u0435\u043D\u043D\u043E
        \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D
        \u043D\u0443\u0436\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E."
    - languageCode: en
      text: 'A small metal nail.

        Useless on its own, but in the right hands
        it holds the world together.

        Tends to disappear exactly when you
        need it most.'
    - languageCode: fr
      text: "Un petit clou en m\xE9tal.\nInutile tout seul, mais entre de bonnes
        mains il maintient le monde en place.\nA tendance \xE0 dispara\xEEtre pr\xE9cis\xE9ment
        quand on en a le plus besoin."
  - key: item.wooden_glue.name
    entries:
    - languageCode: ru
      text: "\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u043A\u043B\u0435\u0439"
    - languageCode: en
      text: Wood Glue
    - languageCode: fr
      text: "Colle \xE0 bois"
  - key: item.wooden_glue.desc
    entries:
    - languageCode: ru
      text: "\u041B\u0438\u043F\u043A\u0430\u044F \u0441\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0438\u044F
        \u0434\u043B\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
        \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445 \u0434\u0435\u0442\u0430\u043B\u0435\u0439.\n\u041D\u0435
        \u0434\u0435\u043B\u0430\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0443
        \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0439, \u043D\u043E \u0434\u0435\u043B\u0430\u0435\u0442
        \u0435\u0451 \u043F\u0440\u043E\u0447\u043D\u043E\u0439.\n\u041F\u0430\u0445\u043D\u0435\u0442
        \u0442\u0430\u043A, \u0447\u0442\u043E \u0441\u0440\u0430\u0437\u0443 \u044F\u0441\u043D\u043E
        \u2014 \u043A\u0442\u043E-\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u0447\u0442\u043E-\u0442\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0438\u043B."
    - languageCode: en
      text: "A sticky substance used to bond wooden parts.\nIt doesn\u2019t make
        the work pretty, but it makes it strong.\nSmells like someone has definitely
        been crafting today."
    - languageCode: fr
      text: "Une substance collante pour assembler des pi\xE8ces en bois.\nCe n\u2019est
        pas tr\xE8s joli, mais c\u2019est solide.\nSon odeur trahit imm\xE9diatement
        qu\u2019un bricolage a eu lieu aujourd\u2019hui."
  - key: item.fiber.name
    entries:
    - languageCode: ru
      text: "\u0412\u043E\u043B\u043E\u043A\u043D\u043E"
    - languageCode: en
      text: Fiber
    - languageCode: fr
      text: Fibre
  - key: item.fiber.desc
    entries:
    - languageCode: ru
      text: "\u0413\u0440\u0443\u0431\u043E\u0435 \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u043E\u0435
        \u0432\u043E\u043B\u043E\u043A\u043D\u043E.\n\u041D\u0430 \u0432\u0438\u0434
        \u2014 \u043C\u0443\u0441\u043E\u0440, \u043D\u0430 \u0434\u0435\u043B\u0435
        \u2014 \u043E\u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B
        \u0440\u0435\u043C\u0435\u0441\u043B\u0430.\n\u0418\u0437 \u043D\u0435\u0433\u043E
        \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u043F\u0443\u0442\u044C
        \u0432\u0435\u0440\u0451\u0432\u043A\u0438, \u0442\u043A\u0430\u043D\u0438
        \u0438 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0430."
    - languageCode: en
      text: "A coarse natural fiber.\nLooks like junk, but forms the basis of half
        of all crafting.\nRopes, fabrics, and a crafter\u2019s patience all begin
        here."
    - languageCode: fr
      text: "Une fibre naturelle grossi\xE8re.\n\xC7a ressemble \xE0 un d\xE9chet,
        mais c\u2019est la base de la moiti\xE9 de l\u2019artisanat.\nCordes, tissus
        et patience de l\u2019artisan commencent ici."
  - key: item.stone.name
    entries:
    - languageCode: ru
      text: "\u041A\u0430\u043C\u0435\u043D\u044C"
    - languageCode: en
      text: Stone
    - languageCode: fr
      text: Pierre
  - key: item.stone.desc
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u0430\u043C\u0435\u043D\u044C,
        \u043F\u043E\u0434\u043D\u044F\u0442\u044B\u0439 \u0441 \u0437\u0435\u043C\u043B\u0438.\n\u0422\u044F\u0436\u0451\u043B\u044B\u0439,
        \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0438 \u0447\u0435\u0441\u0442\u043D\u044B\u0439.\n\u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
        \u0434\u043B\u044F \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
        \u043C\u0435\u0442\u0430\u043D\u0438\u044F \u0438 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F
        \u043E \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438."
    - languageCode: en
      text: 'A simple stone picked up from the ground.

        Heavy, cold, and
        honest.

        Useful for building, throwing, or reminding someone of reality.'
    - languageCode: fr
      text: "Une simple pierre ramass\xE9e par terre.\nLourde, froide et honn\xEAte.\nUtile
        pour construire, lancer ou rappeler la r\xE9alit\xE9."
  - key: item.quartz.name
    entries:
    - languageCode: ru
      text: "\u041A\u0432\u0430\u0440\u0446"
    - languageCode: en
      text: Quartz
    - languageCode: fr
      text: Quartz
  - key: item.quartz.desc
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
        \u043A\u0432\u0430\u0440\u0446\u0430.\n\u041A\u0440\u0430\u0441\u0438\u0432\u044B\u0439,
        \u0442\u0432\u0451\u0440\u0434\u044B\u0439 \u0438 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439 \u0431\u0435\u0437
        \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F.\n\u0427\u0430\u0441\u0442\u043E
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
        \u0442\u0430\u043C, \u0433\u0434\u0435 \u043D\u0443\u0436\u043D\u0430 \u043D\u0430\u0443\u043A\u0430,
        \u043C\u0430\u0433\u0438\u044F \u0438\u043B\u0438 \u0438\u0445 \u0438\u043C\u0438\u0442\u0430\u0446\u0438\u044F."
    - languageCode: en
      text: 'A clear quartz crystal.

        Beautiful, hard, and suspiciously useless
        without the right application.

        Often used where science, magic,
        or an imitation of either is required.'
    - languageCode: fr
      text: "Un cristal de quartz transparent.\nBeau, dur et \xE9trangement inutile
        sans le bon usage.\nSouvent utilis\xE9 l\xE0 o\xF9 la science, la magie ou
        leur imitation sont n\xE9cessaires."
  - key: item.salt.name
    entries:
    - languageCode: ru
      text: "\u0421\u043E\u043B\u044C"
    - languageCode: en
      text: Salt
    - languageCode: fr
      text: Sel
  - key: item.salt.desc
    entries:
    - languageCode: ru
      text: "\u0411\u0435\u043B\u044B\u0435 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B
        \u0441\u043E\u043B\u0438.\n\u041D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u0430,
        \u043F\u043E\u043A\u0430 \u043D\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F.\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
        \u0434\u043B\u044F \u0435\u0434\u044B, \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
        \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0438 \u0437\u0430\u0449\u0438\u0442\u044B
        \u043E\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432."
    - languageCode: en
      text: 'White crystals of salt.

        Unnoticed until it runs out.

        Used
        for food, preserving supplies, and protection against strange creatures.'
    - languageCode: fr
      text: "Des cristaux blancs de sel.\nOn ne la remarque que lorsqu\u2019elle
        vient \xE0 manquer.\nUtilis\xE9e pour la cuisine, la conservation et la protection
        contre des cr\xE9atures \xE9tranges."
  - key: item.glass.name
    entries:
    - languageCode: ru
      text: "\u0421\u0442\u0435\u043A\u043B\u043E"
    - languageCode: en
      text: Glass
    - languageCode: fr
      text: Verre
  - key: item.glass.desc
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u0438
        \u0445\u0440\u0443\u043F\u043A\u0438\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B.\n\u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0442
        \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E, \u043F\u043E\u043A\u0430
        \u043D\u0435 \u0440\u0430\u0437\u043E\u0431\u044C\u0451\u0442\u0441\u044F.\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
        \u0434\u043B\u044F \u0441\u043E\u0441\u0443\u0434\u043E\u0432, \u043E\u043A\u043E\u043D
        \u0438 \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u044B\u0445
        \u043E\u0448\u0438\u0431\u043E\u043A."
    - languageCode: en
      text: 'A transparent and fragile material.

        Looks safe until it shatters.

        Used
        for containers, windows, and painful mistakes.'
    - languageCode: fr
      text: "Un mat\xE9riau transparent et fragile.\nIl para\xEEt inoffensif jusqu\u2019\xE0
        ce qu\u2019il se brise.\nUtilis\xE9 pour des r\xE9cipients, des fen\xEAtres
        et des erreurs douloureuses."
  sourceCsvName: ui_items
