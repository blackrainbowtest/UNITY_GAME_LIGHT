%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 72b5dfd223e65a04db6c6ba1b78d3607, type: 3}
  m_Name: ui_battle
  m_EditorClassIdentifier: Assembly-CSharp::UIStringsData
  strings:
  - key: btn_attack
    entries:
    - languageCode: ru
      text: "\u0410\u0442\u0430\u043A\u0430"
    - languageCode: en
      text: Attack
    - languageCode: fr
      text: Attaque
  - key: btn_item
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442"
    - languageCode: en
      text: Item
    - languageCode: fr
      text: Objet
  - key: btn_exit
    entries:
    - languageCode: ru
      text: "\u0412\u044B\u0445\u043E\u0434"
    - languageCode: en
      text: Exit
    - languageCode: fr
      text: Quitter
  - key: battle_tooltip_damage_fmt
    entries:
    - languageCode: ru
      text: "\u0423\u0440\u043E\u043D: {0}"
    - languageCode: en
      text: 'Damage: {0}'
    - languageCode: fr
      text: "D\xE9g\xE2ts : {0}"
  - key: battle_tooltip_heal_fmt
    entries:
    - languageCode: ru
      text: "\u041B\u0435\u0447\u0435\u043D\u0438\u0435: {0}"
    - languageCode: en
      text: 'Healing: {0}'
    - languageCode: fr
      text: 'Soins : {0}'
  - key: battle_tooltip_mp_cost_fmt
    entries:
    - languageCode: ru
      text: 'MP: {0}'
    - languageCode: en
      text: 'MP: {0}'
    - languageCode: fr
      text: 'PM : {0}'
  - key: battle_tooltip_sp_cost_fmt
    entries:
    - languageCode: ru
      text: 'SP: {0}'
    - languageCode: en
      text: 'SP: {0}'
    - languageCode: fr
      text: 'SP : {0}'
  - key: battle_tooltip_lp_cost_fmt
    entries:
    - languageCode: ru
      text: 'LP: {0}'
    - languageCode: en
      text: 'LP: {0}'
    - languageCode: fr
      text: 'LP : {0}'
  - key: battle_button_attack_menu_name
    entries:
    - languageCode: ru
      text: "\u0410\u0442\u0430\u043A\u0430"
    - languageCode: en
      text: Attack
    - languageCode: fr
      text: Attaque
  - key: battle_button_attack_menu_desc
    entries:
    - languageCode: ru
      text: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438,
        \u043D\u0430\u043D\u043E\u0441\u044F\u0449\u0438\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0443\u0440\u043E\u043D \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443."
    - languageCode: en
      text: Abilities that deal physical damage to the enemy.
    - languageCode: fr
      text: "Comp\xE9tences infligeant des d\xE9g\xE2ts physiques \xE0 l\u2019ennemi."
  - key: battle_action_block_name
    entries:
    - languageCode: ru
      text: "\u0417\u0430\u0449\u0438\u0442\u0430"
    - languageCode: en
      text: Defend
    - languageCode: fr
      text: "D\xE9fense"
  - key: battle_action_block_desc
    entries:
    - languageCode: ru
      text: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F, \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u044E\u0449\u0438\u0435
        \u0432\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0443\u0440\u043E\u043D."
    - languageCode: en
      text: Actions that reduce incoming damage.
    - languageCode: fr
      text: "Actions r\xE9duisant les d\xE9g\xE2ts re\xE7us."
  - key: battle_button_magic_menu_name
    entries:
    - languageCode: ru
      text: "\u041C\u0430\u0433\u0438\u044F"
    - languageCode: en
      text: Magic
    - languageCode: fr
      text: Magie
  - key: battle_button_magic_menu_desc
    entries:
    - languageCode: ru
      text: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438,
        \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044E\u0449\u0438\u0435 \u043C\u0430\u043D\u0443."
    - languageCode: en
      text: Abilities that use mana.
    - languageCode: fr
      text: "Comp\xE9tences magiques consommant du mana."
  - key: battle_button_actions_menu_name
    entries:
    - languageCode: ru
      text: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F"
    - languageCode: en
      text: Actions
    - languageCode: fr
      text: Actions
  - key: battle_button_actions_menu_desc
    entries:
    - languageCode: ru
      text: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043C\u0435\u043D\u044E
        \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
        \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439."
    - languageCode: en
      text: Open the additional actions menu.
    - languageCode: fr
      text: "Ouvrir le menu d\u2019actions suppl\xE9mentaires."
  - key: battle_button_seduction_menu_name
    entries:
    - languageCode: ru
      text: "\u0421\u043E\u0431\u043B\u0430\u0437\u043D\u0435\u043D\u0438\u0435"
    - languageCode: en
      text: Seduction
    - languageCode: fr
      text: "S\xE9duction"
  - key: battle_button_seduction_menu_desc
    entries:
    - languageCode: ru
      text: "\u0421\u043E\u0431\u043B\u0430\u0437\u043D\u044F\u044E\u0449\u0438\u0435
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0449\u0438\u0435
        \u043F\u043E\u0445\u043E\u0442\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430."
    - languageCode: en
      text: Seductive abilities that increase enemy lust.
    - languageCode: fr
      text: "Comp\xE9tences de s\xE9duction augmentant la luxure de l\u2019ennemi."
  - key: battle_button_item_name
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442"
    - languageCode: en
      text: Item
    - languageCode: fr
      text: Objet
  - key: battle_button_item_desc
    entries:
    - languageCode: ru
      text: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432 \u0431\u043E\u044E."
    - languageCode: en
      text: Use an item in battle.
    - languageCode: fr
      text: Utiliser un objet pendant le combat.
  - key: battle_button_exit_name
    entries:
    - languageCode: ru
      text: "\u0412\u044B\u0445\u043E\u0434"
    - languageCode: en
      text: Exit
    - languageCode: fr
      text: Quitter
  - key: battle_button_exit_desc
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0431\u043E\u0439."
    - languageCode: en
      text: Leave the battle.
    - languageCode: fr
      text: Quitter le combat.
  - key: battle_button_run_name
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u0431\u0435\u0433"
    - languageCode: en
      text: Run
    - languageCode: fr
      text: Fuite
  - key: battle_button_run_desc
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0441\u0431\u0435\u0436\u0430\u0442\u044C
        \u0438\u0437 \u0431\u043E\u044F."
    - languageCode: en
      text: Attempt to flee from battle.
    - languageCode: fr
      text: Tenter de fuir le combat.
  - key: battle_button_surrender_name
    entries:
    - languageCode: ru
      text: "\u0421\u0434\u0430\u0442\u044C\u0441\u044F"
    - languageCode: en
      text: Surrender
    - languageCode: fr
      text: Abandonner
  - key: battle_button_surrender_desc
    entries:
    - languageCode: ru
      text: "\u0421\u0434\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443."
    - languageCode: en
      text: Give up the fight.
    - languageCode: fr
      text: Abandonner le combat.
  - key: battle_button_skip_turn_name
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u043E\u043F\u0443\u0441\u043A \u0445\u043E\u0434\u0430"
    - languageCode: en
      text: Skip Turn
    - languageCode: fr
      text: Passer le tour
  - key: battle_button_skip_turn_desc
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0442\u0435\u043A\u0443\u0449\u0438\u0439
        \u0445\u043E\u0434."
    - languageCode: en
      text: Skip the current turn.
    - languageCode: fr
      text: Pass the current turn.
  - key: battle_button_inventory_name
    entries:
    - languageCode: ru
      text: "\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C"
    - languageCode: en
      text: Inventory
    - languageCode: fr
      text: Inventaire
  - key: battle_button_inventory_desc
    entries:
    - languageCode: ru
      text: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C."
    - languageCode: en
      text: Open the inventory.
    - languageCode: fr
      text: "Ouvrir l\u2019inventaire."
  - key: battle_button_button_back_name
    entries:
    - languageCode: ru
      text: "\u041D\u0430\u0437\u0430\u0434"
    - languageCode: en
      text: Back
    - languageCode: fr
      text: Retour
  - key: battle_button_button_back_desc
    entries:
    - languageCode: ru
      text: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0435
        \u043C\u0435\u043D\u044E."
    - languageCode: en
      text: Return to the previous menu.
    - languageCode: fr
      text: "Revenir au menu pr\xE9c\xE9dent."
  - key: battle_action_fast_attack_name
    entries:
    - languageCode: ru
      text: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u0430\u0442\u0430\u043A\u0430"
    - languageCode: en
      text: Fast Attack
    - languageCode: fr
      text: Attaque rapide
  - key: battle_action_fast_attack_desc
    entries:
    - languageCode: ru
      text: "\u0421\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        \u0443\u0434\u0430\u0440 \u0441 \u043D\u0438\u0437\u043A\u043E\u0439 \u0437\u0430\u0442\u0440\u0430\u0442\u043E\u0439
        \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 (\u043C\u043E\u0436\u0435\u0442
        \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u0435)."
    - languageCode: en
      text: A swift strike with low resource cost (may cause bleeding).
    - languageCode: fr
      text: "Frappe rapide avec un faible co\xFBt en ressources (peut provoquer un
        saignement)."
  - key: battle_action_normal_attack_name
    entries:
    - languageCode: ru
      text: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u0430\u0442\u0430\u043A\u0430"
    - languageCode: en
      text: Normal Attack
    - languageCode: fr
      text: Attaque normale
  - key: battle_action_normal_attack_desc
    entries:
    - languageCode: ru
      text: "\u0421\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
        \u0443\u0434\u0430\u0440, \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0449\u0438\u0439
        \u0441\u0438\u043B\u0443 \u0438 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
        (\u043C\u043E\u0436\u0435\u0442 \u043E\u0441\u043B\u0430\u0431\u0438\u0442\u044C
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430)."
    - languageCode: en
      text: A balanced strike combining power and precision (may weaken the enemy).
    - languageCode: fr
      text: "Frappe \xE9quilibr\xE9e alliant puissance et pr\xE9cision (peut affaiblir
        l\u2019ennemi)."
  - key: battle_action_heavy_attack_name
    entries:
    - languageCode: ru
      text: "\u0422\u044F\u0436\u0451\u043B\u0430\u044F \u0430\u0442\u0430\u043A\u0430"
    - languageCode: en
      text: Heavy Attack
    - languageCode: fr
      text: Attaque lourde
  - key: battle_action_heavy_attack_desc
    entries:
    - languageCode: ru
      text: "\u0421\u043E\u043A\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
        \u0443\u0434\u0430\u0440 \u0441 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
        \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E (\u043C\u043E\u0436\u0435\u0442
        \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430)."
    - languageCode: en
      text: A crushing blow with high cost (may stun the enemy).
    - languageCode: fr
      text: "Frappe d\xE9vastatrice avec un co\xFBt \xE9lev\xE9 (peut \xE9tourdir
        l\u2019ennemi)."
  - key: battle_action_counter_attack_name
    entries:
    - languageCode: ru
      text: "\u041A\u043E\u043D\u0442\u0440\u0430\u0442\u0430\u043A\u0430"
    - languageCode: en
      text: Counter Attack
    - languageCode: fr
      text: Contre-attaque
  - key: battle_action_counter_attack_desc
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u0439
        \u0443\u0434\u0430\u0440, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0438\u0439
        \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0433\u043E
        \u0443\u0440\u043E\u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443."
    - languageCode: en
      text: Prepare a retaliatory strike that reflects part of the damage received.
    - languageCode: fr
      text: "Pr\xE9parer une riposte qui renvoie une partie des d\xE9g\xE2ts subis."
  - key: battle_action_fire_spell_name
    entries:
    - languageCode: ru
      text: "\u041E\u0433\u043D\u0435\u043D\u043D\u043E\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435"
    - languageCode: en
      text: Fire Spell
    - languageCode: fr
      text: Sort de feu
  - key: battle_action_fire_spell_desc
    entries:
    - languageCode: ru
      text: "\u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043F\u043B\u0430\u043C\u044F,
        \u043D\u0430\u043D\u043E\u0441\u044F\u0449\u0435\u0435 \u0446\u0435\u043B\u0438
        \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u043D."
    - languageCode: en
      text: Unleash flames that burn the target.
    - languageCode: fr
      text: "D\xE9cha\xEEne des flammes qui br\xFBlent la cible."
  - key: battle_action_ice_spell_name
    entries:
    - languageCode: ru
      text: "\u041B\u0435\u0434\u044F\u043D\u043E\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435"
    - languageCode: en
      text: Ice Spell
    - languageCode: fr
      text: Sort de glace
  - key: battle_action_ice_spell_desc
    entries:
    - languageCode: ru
      text: "\u041B\u0435\u0434\u044F\u043D\u0430\u044F \u043C\u0430\u0433\u0438\u044F,
        \u043D\u0430\u043D\u043E\u0441\u044F\u0449\u0430\u044F \u0446\u0435\u043B\u0438
        \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0443\u0440\u043E\u043D."
    - languageCode: en
      text: Ice magic that strikes the target with freezing power.
    - languageCode: fr
      text: "Magie de glace frappant la cible d\u2019un froid mordant."
  - key: battle_action_holy_spell_name
    entries:
    - languageCode: ru
      text: "\u0421\u0432\u044F\u0442\u043E\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435"
    - languageCode: en
      text: Holy Spell
    - languageCode: fr
      text: "Sort sacr\xE9"
  - key: battle_action_holy_spell_desc
    entries:
    - languageCode: ru
      text: "\u0421\u0432\u044F\u0449\u0435\u043D\u043D\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F
        \u0438\u0441\u0446\u0435\u043B\u044F\u0435\u0442 \u0432\u0430\u0448\u0438
        \u0440\u0430\u043D\u044B."
    - languageCode: en
      text: Sacred energy restores your wounds.
    - languageCode: fr
      text: "L\u2019\xE9nergie sacr\xE9e restaure vos blessures."
  - key: battle_action_dark_spell_name
    entries:
    - languageCode: ru
      text: "\u0422\u0451\u043C\u043D\u043E\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435"
    - languageCode: en
      text: Dark Spell
    - languageCode: fr
      text: "Sort t\xE9n\xE9breux"
  - key: battle_action_dark_spell_desc
    entries:
    - languageCode: ru
      text: "\u0422\u0451\u043C\u043D\u0430\u044F \u043C\u0430\u0433\u0438\u044F,
        \u0432\u044B\u0441\u0430\u0441\u044B\u0432\u0430\u044E\u0449\u0430\u044F
        \u0436\u0438\u0437\u043D\u044C \u0438\u0437 \u0432\u0440\u0430\u0433\u0430
        \u0438 \u0438\u0441\u0446\u0435\u043B\u044F\u044E\u0449\u0430\u044F \u0432\u0430\u0441."
    - languageCode: en
      text: Dark magic that drains life from the enemy and restores yours.
    - languageCode: fr
      text: "Magie t\xE9n\xE9breuse drainant la vie de l\u2019ennemi pour vous soigner."
  - key: battle_action_seduction_act1_name
    entries:
    - languageCode: ru
      text: "\u0421\u043B\u0430\u0431\u044B\u0439 \u043D\u0430\u043C\u0435\u043A
        \u043D\u0430 \u0431\u043B\u0438\u0437\u043E\u0441\u0442\u044C"
    - languageCode: en
      text: Subtle Hint of Intimacy
    - languageCode: fr
      text: "Subtile allusion \xE0 l\u2019intimit\xE9"
  - key: battle_action_seduction_act1_desc
    entries:
    - languageCode: ru
      text: "\u041D\u0430 \u043A\u0440\u0430\u0439\u043D\u0438\u0439 \u0441\u043B\u0443\u0447\u0430\u0439
        \u0438 \u044D\u0442\u043E \u0441\u043E\u0439\u0434\u0435\u0442."
    - languageCode: en
      text: If nothing else works, even this might do.
    - languageCode: fr
      text: En dernier recours, cela peut suffire.
  - key: battle_action_seduction_act2_name
    entries:
    - languageCode: ru
      text: "\u041E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0439 \u043D\u0430\u043C\u0435\u043A
        \u043D\u0430 \u0431\u043B\u0438\u0437\u043E\u0441\u0442\u044C"
    - languageCode: en
      text: Obvious Hint of Intimacy
    - languageCode: fr
      text: "Allusion \xE9vidente \xE0 l\u2019intimit\xE9"
  - key: battle_action_seduction_act2_desc
    entries:
    - languageCode: ru
      text: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043E\u043D \u0432\u0430\u043C
        \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F."
    - languageCode: en
      text: Perhaps you actually like them.
    - languageCode: fr
      text: "Peut-\xEAtre qu\u2019il vous pla\xEEt."
  - key: battle_action_seduction_act3_name
    entries:
    - languageCode: ru
      text: "\u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u043D\u0430\u043C\u0435\u043A
        \u043D\u0430 \u0431\u043B\u0438\u0437\u043E\u0441\u0442\u044C"
    - languageCode: en
      text: Strong Hint of Intimacy
    - languageCode: fr
      text: "Forte allusion \xE0 l\u2019intimit\xE9"
  - key: battle_action_seduction_act3_desc
    entries:
    - languageCode: ru
      text: "\u0412\u0441\u0435 \u043F\u043E \u043E\u0431\u043E\u044E\u0434\u043D\u043E\u043C\u0443
        \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044E."
    - languageCode: en
      text: All of it by mutual consent.
    - languageCode: fr
      text: "Tout cela d\u2019un commun accord."
  - key: battle_action_seduction_act4_name
    entries:
    - languageCode: ru
      text: "\u0411\u0440\u0430\u0447\u043D\u044B\u0439 \u0441\u0435\u0437\u043E\u043D"
    - languageCode: en
      text: Mating Season
    - languageCode: fr
      text: Saison des amours
  - key: battle_action_seduction_act4_desc
    entries:
    - languageCode: ru
      text: "\u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A
        \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442
        \u043D\u0430\u043C\u0435\u043A\u043E\u0432."
    - languageCode: en
      text: When the enemy completely fails to understand hints.
    - languageCode: fr
      text: "Quand l\u2019ennemi ne comprend vraiment pas les sous-entendus."
  - key: battle_action_action_act1_name
    entries:
    - languageCode: ru
      text: "\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C"
    - languageCode: en
      text: Inventory
    - languageCode: fr
      text: Inventaire
  - key: battle_action_action_act1_desc
    entries:
    - languageCode: ru
      text: "\u0410 \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0432 \u0441\u0443\u043C\u043A\u0435."
    - languageCode: en
      text: "Let\u2019s see what\u2019s in my bag."
    - languageCode: fr
      text: "Voyons ce qu\u2019il y a dans mon sac."
  - key: battle_action_action_act2_name
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u0431\u0435\u0433"
    - languageCode: en
      text: Run Away
    - languageCode: fr
      text: Fuite
  - key: battle_action_action_act2_desc
    entries:
    - languageCode: ru
      text: "\u0414\u0430\u0436\u0435 \u0441\u043C\u0435\u043B\u044B\u0435 \u0438\u043D\u043E\u0433\u0434\u0430
        \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
        \u0441\u043F\u0438\u043D\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443."
    - languageCode: en
      text: Even the brave sometimes turn their back to survive.
    - languageCode: fr
      text: "M\xEAme les braves doivent parfois tourner le dos pour survivre."
  - key: battle_action_action_act3_name
    entries:
    - languageCode: ru
      text: "\u0421\u0434\u0430\u0432\u0430\u0442\u044C\u0441\u044F"
    - languageCode: en
      text: Surrender
    - languageCode: fr
      text: Abandonner
  - key: battle_action_action_act3_desc
    entries:
    - languageCode: ru
      text: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0434\u0430\u0436\u0435 \u0441\u0438\u043B\u044C\u043D\u044B\u0439
        \u0432\u043E\u0438\u043D \u043D\u0435 \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438
        \u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C \u0431\u0438\u0442\u0432\u0443."
    - languageCode: en
      text: Sometimes even the strongest warrior cannot win the battle.
    - languageCode: fr
      text: "Parfois, m\xEAme le plus fort des guerriers ne peut pas gagner la bataille."
  - key: battle_action_action_act4_name
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0445\u043E\u0434"
    - languageCode: en
      text: Skip Turn
    - languageCode: fr
      text: Passer le tour
  - key: battle_action_action_act4_desc
    entries:
    - languageCode: ru
      text: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E
        \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u0447\u0442\u043E
        \u0435\u0449\u0451 \u0432\u044B\u043A\u0438\u043D\u0435\u0442 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A."
    - languageCode: en
      text: Sometimes it's worth seeing what the enemy will do next.
    - languageCode: fr
      text: "Parfois, il vaut mieux voir ce que l\u2019ennemi fera ensuite."
  - key: battle_choice_easy
    entries:
    - languageCode: ru
      text: "\u0423\u0447\u0435\u043D\u0438\u043A"
    - languageCode: en
      text: Apprentice
    - languageCode: fr
      text: Apprenti
  - key: battle_choice_middle
    entries:
    - languageCode: ru
      text: "\u0418\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439"
    - languageCode: en
      text: Adventurer
    - languageCode: fr
      text: Aventurier
  - key: battle_choice_hard
    entries:
    - languageCode: ru
      text: "\u041A\u043E\u0448\u043C\u0430\u0440"
    - languageCode: en
      text: Nightmare
    - languageCode: fr
      text: Cauchemar
  - key: battle_scene_wheat_field
    entries:
    - languageCode: ru
      text: "\u041F\u0448\u0435\u043D\u0438\u0447\u043D\u043E\u0435 \u043F\u043E\u043B\u0435"
    - languageCode: en
      text: Wheat Field
    - languageCode: fr
      text: "Champ de bl\xE9"
  - key: battle_scene_river
    entries:
    - languageCode: ru
      text: "\u0420\u0435\u043A\u0430"
    - languageCode: en
      text: River
    - languageCode: fr
      text: "Rivi\xE8re"
  - key: battle_scene_valley
    entries:
    - languageCode: ru
      text: "\u0414\u043E\u043B\u0438\u043D\u0430"
    - languageCode: en
      text: Valley
    - languageCode: fr
      text: "Vall\xE9e"
  - key: battle_scene_farm
    entries:
    - languageCode: ru
      text: "\u0424\u0435\u0440\u043C\u0430"
    - languageCode: en
      text: Farm
    - languageCode: fr
      text: Ferme
  - key: battle_results_title
    entries:
    - languageCode: ru
      text: "\u0418\u0422\u041E\u0413\u0418 \u0411\u041E\u042F"
    - languageCode: en
      text: BATTLE RESULTS
    - languageCode: fr
      text: "R\xC9SULTATS DE LA BATAILLE"
  - key: time_in_battle_fmt
    entries:
    - languageCode: ru
      text: "\u0412\u0440\u0435\u043C\u044F \u0432 \u0431\u043E\u044E:"
    - languageCode: en
      text: 'Time in battle:'
    - languageCode: fr
      text: 'Temps en combat:'
  - key: get_damage_fmt
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u043D:"
    - languageCode: en
      text: 'Damage taken:'
    - languageCode: fr
      text: "D\xE9g\xE2ts subis:"
  - key: dealt_damage_fmt
    entries:
    - languageCode: ru
      text: "\u041D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u043D:"
    - languageCode: en
      text: 'Damage dealt:'
    - languageCode: fr
      text: "D\xE9g\xE2ts inflig\xE9s:"
