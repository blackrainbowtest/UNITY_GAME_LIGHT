  strings:
  - key: id_achievements_battle_finished_title
    entries:
    - languageCode: ru
      text: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0431\u0438\u0442\u0432\u0443"
    - languageCode: en
      text: Finish a battle
    - languageCode: fr
      text: Terminer une bataille
  - key: id_achievements_battle_finished_description
    entries:
    - languageCode: ru
      text: "\u0412\u044B \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0438!
        \u0412\u044B \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B\u0438 \u0431\u0438\u0442\u0432\u0443."
    - languageCode: en
      text: You did it! You finished a battle.
    - languageCode: fr
      text: "Vous l'avez fait! Vous avez termin\xE9 une bataille."
