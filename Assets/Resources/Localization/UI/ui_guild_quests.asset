MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 72b5dfd223e65a04db6c6ba1b78d3607, type: 3}
  m_Name: ui_guild_quests
  m_EditorClassIdentifier: UDA2.Localization::UIStringsData
  strings:
  - key: npc_guild_registrar_name
    entries:
    - languageCode: ru
      text: "\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440 \u0433\u0438\u043B\u044C\u0434\u0438\u0438:
        \u041C\u0435\u0440\u0438"
    - languageCode: en
      text: 'Guild Registrar: Mary'
    - languageCode: fr
      text: 'Registraire de guilde: Mary'
  - key: npc_adventurer_lizard_name
    entries:
    - languageCode: ru
      text: "\u041F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0435\u0446:
        \u041B\u0438\u0437\u0430"
    - languageCode: en
      text: 'Adventurer: Liza'
    - languageCode: fr
      text: 'Aventurier: Liza'
  - key: act_task_board_name
    entries:
    - languageCode: ru
      text: "\u0414\u043E\u0441\u043A\u0430 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0439"
    - languageCode: en
      text: Task Board
    - languageCode: fr
      text: Tableau d'affichage
  - key: guild_giver_board_master
    entries:
    - languageCode: ru
      text: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    - languageCode: en
      text: Guild Master
    - languageCode: fr
      text: Maitre de guilde
  - key: guild_daily_task_01_title
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u043C\u043E\u0448\u044C \u043F\u043B\u043E\u0442\u043D\u0438\u043A\u0443"
    - languageCode: en
      text: Carpenter's Help
    - languageCode: fr
      text: Aide du charpentier
  - key: guild_daily_task_01_desc
    entries:
    - languageCode: ru
      text: "\u041C\u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
        \u043F\u043E\u043C\u043E\u0449\u044C \u0441 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
        \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C\u0438 \u0434\u043B\u044F
        \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.
        \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u044E
        5 \u0431\u0440\u0435\u0432\u043D\u0430"
    - languageCode: en
      text: I need help with some materials for construction. Bring 5 branches to
        the guild
    - languageCode: fr
      text: "J'ai besoin d'aide avec des mat\xE9riaux pour la construction. Apportez
        5 branches \xE0 la guilde"
  - key: guild_daily_task_02_title
    entries:
    - languageCode: ru
      text: "\u041F\u043E\u043C\u043E\u0448\u044C \u043F\u043E\u0432\u0430\u0440\u0443"
    - languageCode: en
      text: Cook's Help
    - languageCode: fr
      text: Aide du cuisinier
  - key: guild_daily_task_02_desc
    entries:
    - languageCode: ru
      text: "\u0423 \u043C\u0435\u043D\u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C
        \u043F\u0430\u043B\u043A\u0438 \u0434\u043B\u044F \u043A\u043E\u0441\u0442\u0440\u0430.
        \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u044E
        10 \u043F\u0430\u043B\u043E\u043A"
    - languageCode: en
      text: I'm out of sticks for the fire. Bring 10 sticks to the guild
    - languageCode: fr
      text: "Je n'ai plus de b\xE2tons pour le feu. Apportez 10 b\xE2tons \xE0 la
        guilde"
  - key: guild_daily_task_03_title
    entries:
    - languageCode: ru
      text: "\u0421\u0438\u0440\u043E\u0442\u0441\u043A\u0438\u0439 \u043F\u0440\u0438\u044E\u0442"
    - languageCode: en
      text: Orphanage
    - languageCode: fr
      text: Orphelinat
  - key: guild_daily_task_03_desc
    entries:
    - languageCode: ru
      text: "\u041D\u0430\u043C \u043D\u0443\u0436\u043D\u044B \u0432\u043E\u043B\u043E\u043A\u043D\u0430
        \u0434\u043B\u044F \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F
        \u0431\u0438\u043D\u0442\u043E\u0432. \u041F\u0440\u0438\u043D\u0435\u0441\u0438
        \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u044E 15 \u0432\u043E\u043B\u043E\u043A\u043E\u043D"
    - languageCode: en
      text: We need fibers for making bandages. Bring 15 fibers to the guild
    - languageCode: fr
      text: "Nous avons besoin de fibres pour fabriquer des bandages. Apportez 15
        fibres \xE0 la guilde"
  - key: guild_daily_task_04_title
    entries:
    - languageCode: ru
      text: "\u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
        \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    - languageCode: en
      text: Wandering Merchant
    - languageCode: fr
      text: "Commer\xE7ant itin\xE9rant"
  - key: guild_daily_task_04_desc
    entries:
    - languageCode: ru
      text: "\u042F \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u043A\u0443\u043F\u0438\u0442\u044C
        \u0443 \u0432\u0430\u0441 \u0434\u0440\u0435\u0432\u0435\u0441\u043D\u044B\u0439
        \u043A\u043B\u0435\u0439. \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0432
        \u0433\u0438\u043B\u044C\u0434\u0438\u044E 2 \u0434\u0440\u0435\u0432\u0435\u0441\u043D\u043E\u0433\u043E
        \u043A\u043B\u0435\u044F"
    - languageCode: en
      text: I'm willing to buy some wood glue from you. Bring 2 wood glues to the
        guild
    - languageCode: fr
      text: "Je suis pr\xEAt \xE0 acheter de la colle \xE0 bois chez vous. Apportez
        2 colles \xE0 bois \xE0 la guilde"
  - key: guild_daily_task_05_title
    entries:
    - languageCode: ru
      text: "\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043A\u0440\u044B\u0441\u043E\u043B\u043E\u0432"
    - languageCode: en
      text: Rat Catcher Needed
    - languageCode: fr
      text: "Chasseur de rats n\xE9cessaire"
  - key: guild_daily_task_05_desc
    entries:
    - languageCode: ru
      text: "\u0412 \u044D\u0442\u043E\u0442 \u0441\u0435\u0437\u043E\u043D \u0443\u0440\u043E\u0436\u0430\u0439
        \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B
        \u043E\u0442 \u043F\u0448\u0435\u0438\u043D\u0447\u043D\u044B\u0445 \u043A\u0440\u044B\u0441.
        \u0418\u0441\u0442\u0440\u0435\u0431\u0438\u0442\u0435 \u0445\u043E\u0442\u044F
        \u0431\u044B 10 \u043A\u0440\u044B\u0441"
    - languageCode: en
      text: The crop has been heavily affected by wheat rats this season. Exterminate
        at least 10 rats
    - languageCode: fr
      text: "La r\xE9colte a \xE9t\xE9 fortement affect\xE9e par les rats de bl\xE9
        cette saison. Exterminez au moins 10 rats"
  - key: guild_daily_task_06_title
    entries:
    - languageCode: ru
      text: "\u041A\u0440\u0430\u0441\u043E\u0442\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
        \u0436\u0435\u0440\u0442\u0432"
    - languageCode: en
      text: Beauty Requires Sacrifice
    - languageCode: fr
      text: "La beaut\xE9 exige des sacrifices"
  - key: guild_daily_task_06_desc
    entries:
    - languageCode: ru
      text: "\u0412 \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
        \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043D\u043E\u0432\u044B\u0439
        \u0441\u043B\u0443\u0445 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u0430
        \u0441\u043B\u0438\u0437\u0438 \u043E\u043C\u043E\u043B\u0430\u0436\u0438\u0432\u0430\u0435\u0442
        \u043A\u043E\u0436\u0443. \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0432
        \u0433\u0438\u043B\u044C\u0434\u0438\u044E 5 \u043C\u0435\u043C\u0431\u0440\u0430\u043D
        \u0441\u043B\u0438\u0437\u0438"
    - languageCode: en
      text: The upper city has a new rumor that slime membrane rejuvenates the skin.
        Bring 5 slime membranes to the guild
    - languageCode: fr
      text: "La haute ville a une nouvelle rumeur selon laquelle la membrane de slime
        rajeunit la peau. Apportez 5 membranes de slime \xE0 la guilde"
  - key: guild_daily_task_07_title
    entries:
    - languageCode: ru
      text: "\u0427\u0443\u0436\u0430\u043A\u0438"
    - languageCode: en
      text: Strangers
    - languageCode: fr
      text: "\xC9trangers"
  - key: guild_daily_task_07_desc
    entries:
    - languageCode: ru
      text: "\u0412 \u0442\u0440\u0443\u0449\u043E\u0431\u0430\u0445 \u043F\u043E\u044F\u0432\u0438\u0441\u0438\u0441\u044C
        \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u043B\u044E\u0434\u0438.
        \u0421\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u044D\u0442\u043E
        \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B.
        \u041F\u043E\u0439\u043C\u0430\u0439\u0442\u0435 5 \u0438\u0437 \u043D\u0438\u0445
        \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u044E"
    - languageCode: en
      text: Strange people have been appearing in the slums. They're likely slavers.
        Capture 5 of them and bring them to the guild
    - languageCode: fr
      text: "Des gens \xE9tranges sont apparus dans les bidonvilles. Ils sont probablement
        des esclavagistes. Capturez-en 5 et apportez-les \xE0 la guilde"
  sourceCsvName: ui_guild_quests
